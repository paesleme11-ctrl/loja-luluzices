<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Grupo de Achadinhos de Beleza e Autocuidado</title>
<meta name="description" content="Entre no grupo grátis e receba ofertas de skincare, maquiagem, cabelo e perfumes direto no WhatsApp.">
<link href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Figtree:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#fdf5f8; --surface:#f6e6f0; --card:#ffffff; --ink:#2a1030; --muted:#6d5470;
  --orchid:#a3267f; --orchid-ink:#ffffff; --peach:#ffb59c; --lilac:#d9c2f0; --rose:#f7a8c8; --line:#ecd3e2;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--bg:#1a0c1d;--surface:#26122a;--card:#2f1a34;--ink:#fbeff6;--muted:#c9aecb;--orchid:#ff8fd0;--orchid-ink:#2a0c26;--line:#43264a;color-scheme:dark}
}
:root[data-theme="dark"]{--bg:#1a0c1d;--surface:#26122a;--card:#2f1a34;--ink:#fbeff6;--muted:#c9aecb;--orchid:#ff8fd0;--orchid-ink:#2a0c26;--line:#43264a;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.6 Figtree,system-ui,sans-serif}
h1,h2,h3{font-family:"Young Serif",Georgia,serif;font-weight:400;margin:0;line-height:1.08}
.wrap{max-width:980px;margin:0 auto;padding:0 22px}
section{padding:60px 0}
.alt{background:var(--surface)}
.hero{padding:44px 0 64px;overflow:hidden}
.hero .wrap{display:grid;gap:40px;align-items:center}
@media(min-width:840px){.hero .wrap{grid-template-columns:1.1fr .9fr}}
h1{font-size:clamp(38px,7.4vw,64px);letter-spacing:-.01em}
.lead{color:var(--muted);font-size:19px;max-width:44ch;margin:18px 0 28px}
.btn{display:inline-flex;align-items:center;gap:10px;background:var(--orchid);color:var(--orchid-ink);font:700 18px Figtree,sans-serif;padding:17px 30px;border-radius:999px;text-decoration:none;transition:transform .15s,box-shadow .15s;box-shadow:0 8px 22px rgba(163,38,127,.28)}
.btn:hover{transform:translateY(-2px)}
.btn:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid var(--peach);outline-offset:3px}
.btn svg{width:22px;height:22px;fill:currentColor}
.fine{font-size:14px;color:var(--muted);margin-top:14px}
.members{display:none;font-weight:700;margin-bottom:14px;color:var(--orchid)}
/* prateleira de arcos */
.shelf{position:relative;height:340px;max-width:380px;width:100%;justify-self:center;display:flex;align-items:flex-end;justify-content:center;gap:14px;border-bottom:6px solid var(--ink)}
.arch{border-radius:999px 999px 18px 18px;position:relative}
.a1{width:96px;height:210px;background:var(--lilac)}
.a2{width:120px;height:290px;background:var(--rose)}
.a3{width:88px;height:170px;background:var(--peach)}
.a1::before,.a3::before{content:"";position:absolute;left:50%;top:-22px;width:34px;height:26px;margin-left:-17px;background:var(--ink);border-radius:8px 8px 3px 3px}
.a2::before{content:"";position:absolute;left:50%;top:44px;width:56px;height:96px;margin-left:-28px;background:rgba(255,255,255,.55);border-radius:999px 999px 10px 10px}
.sticker{position:absolute;right:-4px;top:6px;background:var(--ink);color:var(--bg);font:400 22px "Young Serif",serif;width:104px;height:104px;border-radius:50%;display:grid;place-content:center;text-align:center;line-height:1.05;transform:rotate(10deg)}
.sticker small{font:600 12px Figtree,sans-serif;display:block}
h2{font-size:clamp(28px,5vw,42px);margin-bottom:28px}
.cats{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;padding:0;margin:0;list-style:none}
@media(min-width:700px){.cats{grid-template-columns:repeat(4,1fr)}}
.cats li{background:var(--card);border:1.5px solid var(--line);border-radius:22px;padding:20px 16px;font-weight:700;text-align:center}
.cats li:nth-child(3n+1){border-radius:60px 60px 22px 22px}
.steps{display:grid;gap:22px;padding:0;margin:0;list-style:none;counter-reset:s}
@media(min-width:840px){.steps{grid-template-columns:repeat(3,1fr)}}
.steps li{counter-increment:s;background:var(--card);border-radius:24px;padding:24px;border:1.5px solid var(--line)}
.steps li::before{content:counter(s);display:grid;place-content:center;width:40px;height:40px;border-radius:50%;background:var(--peach);color:#2a1030;font:400 20px "Young Serif",serif;margin-bottom:12px}
.steps h3{font-size:22px;margin-bottom:6px}
.steps p{margin:0;color:var(--muted)}
.offers{display:grid;gap:14px}
@media(min-width:760px){.offers{grid-template-columns:repeat(3,1fr)}}
.msg{background:#e2f7d0;color:#1d2b14;border-radius:4px 18px 18px 18px;padding:15px 17px;font-size:15.5px;line-height:1.45;box-shadow:0 1px 2px rgba(0,0,0,.15)}
.msg b{display:block;margin-bottom:4px}
.note{color:var(--muted);font-size:14px;margin-top:14px}
details{border-bottom:1.5px solid var(--line);padding:18px 0}
summary{cursor:pointer;font:400 20px "Young Serif",serif;list-style:none;display:flex;justify-content:space-between;gap:14px}
summary::after{content:"+";font:700 24px Figtree,sans-serif;color:var(--orchid);line-height:1}
details[open] summary::after{content:"–"}
details p{margin:10px 0 0;color:var(--muted);max-width:60ch}
.final{text-align:center}
.final h2{margin-bottom:14px}
.final p{color:var(--muted);margin:0 auto 26px;max-width:42ch}
footer{padding:28px 0 96px;color:var(--muted);font-size:13px;text-align:center}
.sticky{position:fixed;left:0;right:0;bottom:0;padding:10px 16px calc(10px + env(safe-area-inset-bottom,0px));background:var(--bg);border-top:1px solid var(--line);display:flex;z-index:20}
.sticky .btn{width:100%;justify-content:center;padding:14px}
@media(min-width:840px){.sticky{display:none}footer{padding-bottom:28px}}
@media(prefers-reduced-motion:reduce){.btn{transition:none}}
</style>
<!-- Meta Pixel Code -->
