.cta:focus-visible{outline:3px solid var(--rose);outline-offset:3px}
.cta svg{width:26px;height:26px;fill:#fff;flex:none}
.safe{display:flex;gap:8px;justify-content:center;align-items:center;margin:14px 0 0;color:var(--muted);font-weight:500;font-size:15px}
.safe svg{width:20px;height:20px;stroke:var(--rose);fill:none;stroke-width:1.8}
.spots{display:none;border:1.5px dashed var(--line);border-radius:20px;padding:16px 18px;margin:26px 0 0;text-align:left}
.spots .row{display:flex;justify-content:space-between;font-weight:700}
.spots .row span:last-child{color:var(--rose)}
.bar{height:12px;background:var(--soft);border-radius:99px;margin:10px 0 8px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--rose);border-radius:99px;width:0}
.spots p{margin:0;text-align:right;font-size:14px;color:var(--muted)}
.today{display:none;margin:16px 0 0;font-weight:700;color:var(--ink);font-size:15.5px}
.today::before{content:"";display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--wa);margin-right:8px}
h2{font:700 14px Karla,sans-serif;letter-spacing:.08em;text-transform:uppercase;margin:34px 0 16px}
.list{display:grid;gap:12px;text-align:left}
.item{display:flex;gap:16px;align-items:flex-start;border:1.5px solid var(--line);border-radius:24px;padding:16px 18px}
.ico{flex:none;width:48px;height:48px;border-radius:50%;background:var(--soft);display:grid;place-items:center}
