<script>
// ====== CONFIGURE AQUI ======
var GROUP_LINK  = "https://chat.whatsapp.com/Cf4nJ6wFLMcKrKVIeFK5tv";
var MEMBERS_NOW = 717;   // número REAL de pessoas no grupo (0 = esconde a barra de vagas)
var CAPACITY    = 1024;  // limite de participantes do grupo no WhatsApp (ajuste se mudar)
var JOINED_TODAY = 10;    // quantas pessoas REALMENTE entraram hoje (0 = esconde a linha)
// ============================
document.querySelectorAll(".js-join").forEach(function(a){
  a.href = GROUP_LINK; a.target = "_blank";
  a.addEventListener("click", function(){ try{ if(window.fbq) fbq("track","Lead"); }catch(e){} });
});
if(JOINED_TODAY > 0){var t=document.getElementById("today");t.textContent=JOINED_TODAY+(JOINED_TODAY===1?" pessoa entrou hoje":" pessoas entraram hoje");t.style.display="block"}
if(MEMBERS_NOW > 0 && CAPACITY > MEMBERS_NOW){
  var p = Math.round(MEMBERS_NOW / CAPACITY * 100);
  document.getElementById("pct").textContent = p + "%";
  document.getElementById("fill").style.width = p + "%";
  document.getElementById("left").textContent = "Restam " + (CAPACITY - MEMBERS_NOW) + " vagas";
  document.getElementById("spots").style.display = "block";
}
</script>
